<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Spike build mode: interpreted (default) or aot; set by the publish script. -->
    <SpikeBuild Condition="'$(SpikeBuild)' == ''">interpreted</SpikeBuild>
    <RunAOTCompilation Condition="'$(SpikeBuild)' == 'aot'">true</RunAOTCompilation>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="SpikeBuild" Value="$(SpikeBuild)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.15" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SpikeCore/SpikeCore.csproj" />
    <!-- On-device mode: the page generates the datasets itself with the desktop generator's code (scenario=generate). -->
    <Compile Include="../DatasetGenerator/EventLogBuilder.cs" Link="Generator/EventLogBuilder.cs" />
    <Compile Include="../DatasetGenerator/TextSource.cs" Link="Generator/TextSource.cs" />
  </ItemGroup>

</Project>
