# Code style for the whole repository; analyzers run in the build (EnforceCodeStyleInBuild).
# Changing a diagnostic's severity here counts as a suppression and is checked like one (ADR-042).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,json,yml,yaml,xml,razor,html,css}]
indent_size = 2

[*.{razor,html,css}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
