# Code style for the whole repository; analyzers run in the build (EnforceCodeStyleInBuild).
# Changing a diagnostic's severity here counts as a suppression and is checked like one (ADR-042).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,json,yml,yaml,xml,razor,html,css}]
indent_size = 2

[*.{razor,html,css}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

# Code style (AGENTS.md section 4b): enforced at warning, so the build fails on a breach.
csharp_prefer_braces = true:warning
dotnet_style_require_accessibility_modifiers = always:warning
dotnet_style_qualification_for_field = true:warning
dotnet_style_qualification_for_property = true:warning
dotnet_style_qualification_for_method = true:warning
dotnet_style_qualification_for_event = true:warning

# Private instance fields are camelCase without a prefix; constants and static fields stay PascalCase.
dotnet_diagnostic.IDE1006.severity = warning
dotnet_naming_rule.private_instance_fields_are_camel_case.severity = warning
dotnet_naming_rule.private_instance_fields_are_camel_case.symbols = private_instance_fields
dotnet_naming_rule.private_instance_fields_are_camel_case.style = camel_case

dotnet_naming_symbols.private_instance_fields.applicable_kinds = field
dotnet_naming_symbols.private_instance_fields.applicable_accessibilities = private

dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.camel_case.word_separator =

dotnet_naming_rule.constant_fields_are_pascal_case.severity = warning
dotnet_naming_rule.constant_fields_are_pascal_case.symbols = constant_fields
dotnet_naming_rule.constant_fields_are_pascal_case.style = pascal_case

dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.required_modifiers = const

dotnet_naming_rule.static_fields_are_pascal_case.severity = warning
dotnet_naming_rule.static_fields_are_pascal_case.symbols = static_fields
dotnet_naming_rule.static_fields_are_pascal_case.style = pascal_case

dotnet_naming_symbols.static_fields.applicable_kinds = field
dotnet_naming_symbols.static_fields.required_modifiers = static

dotnet_naming_style.pascal_case.capitalization = pascal_case
